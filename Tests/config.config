[Dir]
# Paths are resolved relative to this configuration file.
# Tests/Install-Dependencies.sh creates the generated tools and benchmark JAR.
FallbackJavaBuild=Tools/jdk-25
LabsOpenJDK=../repos/labs-openjdk-jvmci-25.1-b13
GTSlowdownSchedular=../repos/GTSlowdownSchedular
BuboExperiments=../repos/BuboExperiments
Graal=../repos/graal-instrumentation
AWFYSource=../repos/are-we-fast-yet/benchmarks/Java/src
AWFYBenchmarksJar=Tools/benchmarks.jar
AsyncProfilerLibrary=../repos/are-we-fast-yet/Async/async-profiler-4.2.1-linux-x64/lib/libasyncProfiler.so
RunRoot=Runs

[Run]
# Add a benchmark here and provide a matching [Benchmark.NAME] section.
Benchmarks=Mandelbrot,Bounce
# ReBench Denoise is applied only to measurement stages. Use the command-line
# --without-denoise option for a one-off run without machine tuning.
Denoise=true
BuboLMinRuntimeSharePercent=2
BuboLMaxMedianDifferencePoints=25

[Benchmark.Mandelbrot]
Iterations=300
ExtraArgument=750
ExpectedSlowdownRatio=2
SlowdownTolerancePercent=15

[Benchmark.Bounce]
Iterations=100
ExtraArgument=10000
ExpectedSlowdownRatio=2
SlowdownTolerancePercent=15
